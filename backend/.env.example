# Copy to backend/.env and fill in. NEVER commit .env.
#
# All values are read server-side only via pydantic-settings. None reach the browser.
#
# !! Every comment is on its own line, deliberately. `KEY=   # note` makes python-dotenv read
# !! "# note" AS THE VALUE when the value is empty — so the app believes a key is configured,
# !! sends the comment text to the vendor, and gets a 401 that looks like a bad key.
# !! Do not put a comment on the same line as a setting.
#
# The imaging core (stages 2-5) needs NONE of these. With no keys set, the pipeline runs the
# `local` control engine so the full zip-in / asset-out path works before procurement completes.
# Use scripts/set_env_key.py to set a secret without it appearing in shell history.

# ---------------------------------------------------------------------------
# Segmentation engines (stage 1) — the only AI in the default pipeline
# ---------------------------------------------------------------------------
# Set at least two for dual-engine auto-pick. With one, auto-pick emits SINGLE_ENGINE_ONLY.
# With none, the `local` control engine is used.
#
# PHOTOROOM_API_KEY  ~$0.02/image   docs.photoroom.com          the volume engine
# FAL_KEY            ~$0.03-0.05    fal.ai BiRefNet/BRIA        strong soft alpha
#
# remove.bg was RETIRED on 7 Aug 2026: accuracy did not meet expectation, and at ~$0.20/image it
# was also the most expensive engine by 10x. `RemoveBgEngine` and tests/test_removebg.py remain in
# the tree, unused — set REMOVEBG_API_KEY and add `removebg` to ENGINE_POOL to bring it back.

PHOTOROOM_API_KEY=
FAL_KEY=

# Comma-separated, priority order. The first two available form the auto-pick pair.
#
# `gemini` is intentionally NOT listed here even when GEMINI_API_KEY is set. It is selectable per
# job (Clipping > Single engine > Gemini) but never auto-picked, because its hard-edged mask still
# scores 0.7246 and passes every reject rule — in an AUTO pair it could beat Photoroom on score
# while shipping a visibly worse edge. See docs/ENGINES.md.
ENGINE_POOL=photoroom,falai

# ---------------------------------------------------------------------------
# Auto-pick vision tie-break (optional, advisory)
# ---------------------------------------------------------------------------
# Only invoked when deterministic scoring cannot separate two candidates. Without it, auto-pick
# uses the deterministic score alone — which in testing was just as accurate, instantly and free.
#
# Model id warning: the client report names "Gemini 3 Flash", but `gemini-3-flash` does not exist
# in the API. Measured 6 Aug 2026 with 4 counterbalanced trials each (see docs/ENGINES.md):
#   gemini-3.5-flash        3/4  <- default: best measured, and stable rather than preview
#   gemini-3.6-flash        2/4  order-independent but misses subtle defects
#   gemini-3-flash-preview  2/4  BUT it just picks whichever is shown first — position bias
#   gemini-2.5-flash        cannot tell two cut-outs apart
# Comparisons are counterbalanced (two calls, must agree), so a biased model degrades to the
# deterministic score instead of guessing. The tie-break is advisory and never a quality claim.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIEBREAK_ENABLED=true

# Short on purpose: measured 7-32s per call, and the deterministic answer already exists, so a
# slow call must degrade rather than stall a batch.
GEMINI_TIMEOUT_SECONDS=15

# ---------------------------------------------------------------------------
# Gemini as a selectable segmentation engine (optional)
# ---------------------------------------------------------------------------
# Uses the GEMINI_API_KEY above. Reachable only via Clipping > Single engine > Gemini; never
# auto-picked (see the ENGINE_POOL note). ~$0.0065/image, token-metered.
#
# KNOWN TRADE, measured 7 Aug 2026: the API returns the mask as a POLYGON, so the cut-out has a
# hard edge — 2 distinct alpha values and 0 soft edge pixels, against 27 for ground truth. Every
# such result carries the HARD_EDGED_MASK note. Do not demo it on soft-edged subjects, and expect
# a halo against saturated background colours. See docs/LIMITATIONS.md.
#
# Model matters, and it is not the same choice as the tie-break above:
#   gemini-3.5-flash  returns a polygon        <- the only verified value
#   gemini-3.6-flash  returns COCO RLE         -> this engine raises rather than guess
GEMINI_SEGMENT_MODEL=gemini-3.5-flash

# Full vendor budget, unlike GEMINI_TIMEOUT_SECONDS: this call IS the mask, not an advisory
# opinion, so it must not be cut off. Measured 1.7-4.7s with thinking at MINIMAL.
GEMINI_SEGMENT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Adobe Firefly Services / Photoshop API — layered PSD (stage 5)
# ---------------------------------------------------------------------------
# BLOCKER: enterprise-quoted, not self-serve card signup. Until these exist the PSD stage runs
# the fallback path (docs/PSD.md). ~$0.15/call against an ~$1,000/month minimum.

ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
ADOBE_ORG_ID=

# ---------------------------------------------------------------------------
# Optional AI upscale
# ---------------------------------------------------------------------------
# Only when the requested canvas exceeds the master resolution. Without it, an undersized master
# is padded rather than stretched. Lanczos upscaling is never used.

UPSCALER_ENABLED=false

# ---------------------------------------------------------------------------
# Infrastructure
# ---------------------------------------------------------------------------
# QUEUE_NAME must match `rq worker ... dyi`. The default 'default' queue sits idle.

REDIS_URL=redis://localhost:6379
QUEUE_NAME=dyi

# Local MinIO dev credentials only — not real secrets.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=dyi-poc
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
SIGNED_URL_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Limits — security controls, not tuning knobs. See docs/SECURITY.md
# ---------------------------------------------------------------------------
# MAX_ZIP_BYTES            500 MB compressed upload cap
# MAX_ZIP_ENTRIES          zip-bomb guard: entry count
# MAX_UNCOMPRESSED_BYTES   zip-bomb guard: 2 GB total expanded
# MAX_IMAGE_BYTES          50 MB per image
# MAX_IMAGE_PIXELS         decompression-bomb guard (80 MP)
# MAX_OUTPUT_PIXELS        output-side counterpart: SizeSpec allows 20000x20000 = 400 MP, which is
#                          ~8 GB of float32 buffers from a ~60-byte request body

MAX_ZIP_BYTES=524288000
MAX_ZIP_ENTRIES=200
MAX_UNCOMPRESSED_BYTES=2147483648
MAX_IMAGE_BYTES=52428800
MAX_IMAGE_PIXELS=80000000
MAX_OUTPUT_PIXELS=80000000

VENDOR_TIMEOUT_SECONDS=60
VENDOR_MAX_RETRIES=3

# Parallel per-image calls within one job. Respects vendor rate limits.
WORKER_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# CACHE_CUTOUTS keys on sha256(image)+engine, so re-runs while tuning colour cost $0.

CACHE_CUTOUTS=true
LOG_LEVEL=INFO
